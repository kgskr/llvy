# Discord OAuth2 identity: identify only; user OAuth tokens are never stored.
# Register the exact callback in the Discord Developer Portal.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/discord/callback"

# Install the application's bot in this guild with minimal permissions (0).
# Keep the bot token server-only. No Gateway connection or roster import is used.
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""

# Service owner's exact Discord user ID, copied as a decimal string.
DISCORD_OWNER_USER_ID=""

# Required independent server-only signing secret.
# At least 32 UTF-8 bytes after trimming. Generate: openssl rand -base64 32
# Do not share it with users or reuse any provider secret.
AUTH_SECRET=""

# Neon / existing Vercel Postgres connection values.
# For a new project, connect Neon through the Vercel Marketplace.
# POSTGRES_URL is required by the app and Drizzle client.
# Use the pooled connection string here.
POSTGRES_URL="postgres://user:password@host:5432/database"

# Migrations prefer this direct (non-pooled) URL when it is present.
POSTGRES_URL_NON_POOLING="postgres://user:password@host:5432/database"
# Vercel may also provide these optional POSTGRES_* values.
POSTGRES_PRISMA_URL="postgres://user:password@host:5432/database?pgbouncer=true&connect_timeout=15"
POSTGRES_USER="user"
POSTGRES_HOST="host"
POSTGRES_PASSWORD="password"
POSTGRES_DATABASE="database"

# Optional Upstash Redis cache in Singapore. The Vercel integration supplies REDIS_URL.
# Use the generated TLS URL (port 6379). Keep it server-only, never NEXT_PUBLIC_*.
# Leave empty to query PostgreSQL directly.
REDIS_URL=""
# Optional app namespace; environment and PostgreSQL identity are appended.
REDIS_KEY_PREFIX="llvy"

# Vercel Blob read/write token.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx"

# Match the connected Blob store's access mode (private recommended for replays).
# Existing deployments that omit this keep using public stores.
BLOB_ACCESS="private"

# Required for daily membership reconciliation and expired-upload cleanup.
# Vercel sends it as
# an Authorization bearer token when invoking the configured cron job.
CRON_SECRET="replace-with-a-random-secret-at-least-16-characters"
