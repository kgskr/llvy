# 필수: Discord 애플리케이션과 서버 설정. docs/discord-auth.md 참고.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/discord/callback"
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
DISCORD_OWNER_USER_ID=""

# 필수: 세션 서명용 비밀값. openssl rand -base64 32로 생성.
AUTH_SECRET=""

# 필수: PostgreSQL 연결 문자열. 현재 드라이버의 연결 조건은 docs/deployment.md 참고.
# Neon을 사용하는 경우 pooled URL을 입력합니다.
POSTGRES_URL="postgres://user:password@host:5432/database"

# 선택: DB 초기화에 사용할 direct URL. 비워 두면 POSTGRES_URL을 사용합니다.
POSTGRES_URL_NON_POOLING=""

# 필수: Vercel Blob 스토어의 read-write 토큰과 접근 모드.
BLOB_READ_WRITE_TOKEN=""
BLOB_ACCESS="private"

# 배포 시 필수: 예약 작업 인증용 비밀값. AUTH_SECRET과 별도로 생성.
# 생성 명령: openssl rand -base64 32
CRON_SECRET=""

# 선택: Redis TCP/TLS 연결 URL. 비워 두면 PostgreSQL에서 직접 조회합니다.
# 예: rediss://default:<password>@<host>:6379
REDIS_URL=""

# 선택: 같은 DB와 Redis를 공유하는 독립 프로젝트를 구분할 이름.
REDIS_KEY_PREFIX="llvy"
