{
  "name": "llvy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:integration": "vitest run src/lib/database.integration.test.ts src/lib/pending-upload-store.integration.test.ts src/lib/match-management.integration.test.ts",
    "test:replay": "vitest run src/lib/real-replay.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run lint && npm run typecheck && npm run build && npm run format",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vercel/blob": "~2.5.0",
    "@vercel/postgres": "^0.10.0",
    "drizzle-orm": "^0.45.2",
    "next": "~16.3.8",
    "react": "~19.2.7",
    "react-dom": "~19.2.7",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@next/env": "~16.3.8",
    "@types/node": "^26.0.1",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "~0.28.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "~16.3.8",
    "prettier": "^3.9.1",
    "typescript": "~6.0.3",
    "vitest": "~4.1.11"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
